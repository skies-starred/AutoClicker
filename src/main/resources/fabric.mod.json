{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A very awesome QoL mod.",
  "authors": [
    "Starred"
  ],
  "contact": {},
  "environment": "*",
  "entrypoints": {
    "client": [
      {
        "value": "foo.starred.autoclicker.AutoClicker",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "${id}.mixins.json"
